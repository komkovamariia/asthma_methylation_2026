process {
  executor = 'slurm'
  queue    = 'infinite'

  shell = ['/usr/bin/env', 'bash', '-euo', 'pipefail']

  withName: '.*' {
    clusterOptions = '--job-name=nf-methylseq'
  }

  withName: 'NFCORE_METHYLSEQ:METHYLSEQ:FASTQ_ALIGN_DEDUP_BISMARK:BISMARK_METHYLATIONEXTRACTOR' {
    ext.args = '--CX'
  }
}

executor {
  queueSize = 100
}


process {
  withName: /.*BISMARK_ALIGN.*/ {
    queue  = 'infinite'
    time   = '20d'
    cpus   = 8
    memory = '64 GB'
  }

  withName: /.*BISMARK_DEDUPLICATE.*/ {
    queue  = 'infinite'
    time   = '10d'
    cpus   = 4
    memory = '32 GB'
  }

  withName: /.*BISMARK_METHYLATIONEXTRACTOR.*/ {
    queue  = 'infinite'
    time   = '20d'
    cpus   = 8
    memory = '64 GB'
  }

  withName: /.*SAMTOOLS_SORT.*/ {
    queue  = 'infinite'
    time   = '10d'
    cpus   = 4
    memory = '32 GB'
  }

  withLabel: big_mem {
    queue  = 'infinite'
    time   = '20d'
    cpus   = 32
    memory = '128 GB'
  }
}


