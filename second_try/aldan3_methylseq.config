// ALDAN3 SLURM limits retained from the uploaded targeted-panel run.
params {
    max_cpus = 8
    max_memory = '64.GB'
    max_time = '24.h'
}

process {
    // Avoid noclobber errors when Nextflow recreates .command.trace.
    shell = ['/usr/bin/env', 'bash', '-euo', 'pipefail']
    executor = 'slurm'
    queue = 'infinite'
    errorStrategy = 'retry'
    maxRetries = 2
    maxErrors = -1

    withName: '.*' {
        clusterOptions = '--job-name=nf-methylseq'
    }
    withName: /.*BISMARK_ALIGN.*/ {
        queue = 'infinite'
        time = '20d'
        cpus = 8
        memory = '64 GB'
    }
    withName: /.*BISMARK_DEDUPLICATE.*/ {
        queue = 'infinite'
        time = '10d'
        cpus = 4
        memory = '32 GB'
    }
    withName: /.*BISMARK_METHYLATIONEXTRACTOR.*/ {
        queue = 'infinite'
        time = '20d'
        cpus = 8
        memory = '64 GB'
        // Retain the historical all-context export and nf-core 4.2.0 read-end settings.
        ext.args = { [
            '--CX',
            params.comprehensive ? '--comprehensive' : '',
            params.meth_cutoff ? "--cutoff ${params.meth_cutoff}" : '',
            params.ignore_r1 > 0 ? "--ignore ${params.ignore_r1}" : '',
            params.ignore_3prime_r1 > 0 ? "--ignore_3prime ${params.ignore_3prime_r1}" : '',
            meta.single_end ? '' : (params.no_overlap ? '--no_overlap' : '--include_overlap'),
            meta.single_end ? '' : (params.ignore_r2 > 0 ? "--ignore_r2 ${params.ignore_r2}" : ''),
            meta.single_end ? '' : (params.ignore_3prime_r2 > 0 ? "--ignore_3prime_r2 ${params.ignore_3prime_r2}" : '')
        ].join(' ').trim() }
    }
    withName: /.*SAMTOOLS_SORT.*/ {
        queue = 'infinite'
        time = '10d'
        cpus = 4
        memory = '32 GB'
    }
    withLabel: big_mem {
        queue = 'infinite'
        time = '20d'
        cpus = 32
        memory = '128 GB'
    }
}

executor {
    queueSize = 100
}
